# Copy to .env and edit locally. Never paste credentials into chat or commit .env.
# Existing local .streamlit/secrets.toml Gemini configuration is also supported.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Leave empty to preserve the existing local database/uploads locations.
# Docker/Render MUST use /data with a persistent volume/disk.
VENDENCE_DATA_DIR=
VENDENCE_PUBLIC=0
# Strict requires independently evidenced / authorized human authenticity review.
# demo_consistency is an explicit SYNTHETIC demonstration policy, not authentication.
VENDENCE_APPROVAL_POLICY=strict
# Set to 1 only for an operator-declared workspace containing synthetic inputs.
# The --synthetic-consistency-demo launcher sets both values automatically.
VENDENCE_SYNTHETIC_DATA_ONLY=0

# Public mode requires distinct passwords with at least 12 characters each.
VENDENCE_ACCESS_PASSWORD=
VENDENCE_REVIEWER_PASSWORD=

